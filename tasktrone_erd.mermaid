erDiagram
    %% Core User Management
    users {
        UUID id PK
        TEXT username UK
        TEXT email UK
        TEXT full_name
        user_role role
        team_type team
        TEXT department
        TEXT phone
        BOOLEAN is_active
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% Project Management
    projects {
        UUID id PK
        TEXT title
        TEXT description
        TEXT project_number UK
        TEXT customer
        TIMESTAMPTZ start_date
        TIMESTAMPTZ target_completion_date
        TIMESTAMPTZ actual_completion_date
        manufacturing_phase current_phase
        priority_level priority
        INTEGER wip_limit
        TEXT status
        DECIMAL budget
        UUID created_by FK
        UUID project_manager FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% Kanban Board System
    boards {
        UUID id PK
        UUID project_id FK
        TEXT name
        TEXT description
        BOOLEAN is_default
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    board_columns {
        UUID id PK
        UUID board_id FK
        TEXT name
        INTEGER position
        INTEGER wip_limit
        TEXT column_type
        TIMESTAMPTZ created_at
    }

    swimlanes {
        UUID id PK
        UUID board_id FK
        TEXT name
        TEXT description
        JSONB criteria
        TEXT color
        INTEGER position
        TIMESTAMPTZ created_at
    }

    %% Task Management
    tasks {
        UUID id PK
        UUID project_id FK
        UUID board_id FK
        UUID column_id FK
        TEXT title
        TEXT description
        TEXT task_number
        TEXT task_category
        manufacturing_phase phase
        task_status status
        priority_level priority
        DECIMAL estimated_hours
        DECIMAL actual_hours
        TIMESTAMPTZ due_date
        TIMESTAMPTZ start_date
        TIMESTAMPTZ completion_date
        INTEGER lead_time
        INTEGER cycle_time
        INTEGER position
        UUID parent_task_id FK
        UUID created_by FK
        UUID assigned_to FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_dependencies {
        UUID id PK
        UUID predecessor_task_id FK
        UUID successor_task_id FK
        TEXT dependency_type
        INTEGER lag_time
        TIMESTAMPTZ created_at
    }

    task_requirements {
        UUID id PK
        UUID task_id FK
        TEXT requirement_type
        TEXT description
        TEXT[] file_types
        BOOLEAN is_mandatory
        BOOLEAN is_completed
        TIMESTAMPTZ completed_at
        TIMESTAMPTZ created_at
    }

    %% Many-to-Many Relationships
    project_members {
        UUID project_id PK,FK
        UUID user_id PK,FK
        TEXT role
        TIMESTAMPTZ joined_at
    }

    task_members {
        UUID task_id PK,FK
        UUID user_id PK,FK
        TEXT role
        TIMESTAMPTZ assigned_at
    }

    task_swimlanes {
        UUID task_id PK,FK
        UUID swimlane_id PK,FK
        TIMESTAMPTZ assigned_at
    }

    %% File Management
    attachments {
        UUID id PK
        UUID task_id FK
        UUID project_id FK
        UUID requirement_id FK
        TEXT file_name
        TEXT original_name
        TEXT file_type
        TEXT file_category
        BIGINT file_size
        TEXT storage_path
        INTEGER version
        BOOLEAN is_latest
        UUID uploaded_by FK
        TIMESTAMPTZ uploaded_at
    }

    %% Manufacturing Specific
    equipment {
        UUID id PK
        TEXT name
        TEXT model
        TEXT manufacturer
        TEXT serial_number UK
        TEXT location
        TEXT status
        TIMESTAMPTZ last_maintenance
        TIMESTAMPTZ next_maintenance
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_equipment {
        UUID id PK
        UUID task_id FK
        UUID equipment_id FK
        TIMESTAMPTZ start_time
        TIMESTAMPTZ end_time
        INTEGER setup_time
        INTEGER run_time
        TEXT notes
        TIMESTAMPTZ created_at
    }

    quality_checks {
        UUID id PK
        UUID task_id FK
        UUID inspector_id FK
        TEXT check_type
        TEXT status
        TEXT notes
        JSONB measurements
        INTEGER defects_found
        TIMESTAMPTZ checked_at
        TIMESTAMPTZ created_at
    }

    manufacturing_metrics {
        UUID id PK
        UUID project_id FK
        UUID task_id FK
        TEXT metric_type
        DECIMAL value
        TEXT unit
        TIMESTAMPTZ measurement_date
        UUID measured_by FK
        TEXT notes
        TIMESTAMPTZ created_at
    }

    %% Communication & Audit
    comments {
        UUID id PK
        UUID task_id FK
        UUID project_id FK
        UUID author_id FK
        TEXT content
        BOOLEAN is_system_generated
        UUID[] mentioned_users
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    task_history {
        UUID id PK
        UUID task_id FK
        UUID changed_by FK
        TEXT field_name
        TEXT old_value
        TEXT new_value
        TEXT change_type
        TIMESTAMPTZ changed_at
    }

    %% Relationships
    users ||--o{ projects : "creates"
    users ||--o{ projects : "manages"
    users ||--o{ tasks : "creates"
    users ||--o{ tasks : "assigned_to"
    users ||--o{ attachments : "uploads"
    users ||--o{ comments : "authors"
    users ||--o{ task_history : "changes"
    users ||--o{ quality_checks : "inspects"
    users ||--o{ manufacturing_metrics : "measures"

    projects ||--o{ boards : "has"
    projects ||--o{ tasks : "contains"
    projects ||--o{ project_members : "includes"
    projects ||--o{ attachments : "has_files"
    projects ||--o{ comments : "has_discussions"
    projects ||--o{ manufacturing_metrics : "tracks"

    boards ||--o{ board_columns : "has"
    boards ||--o{ swimlanes : "organizes"
    boards ||--o{ tasks : "displays"

    board_columns ||--o{ tasks : "contains"
    
    swimlanes ||--o{ task_swimlanes : "categorizes"

    tasks ||--o{ tasks : "parent_child"
    tasks ||--o{ task_dependencies : "predecessor"
    tasks ||--o{ task_dependencies : "successor"
    tasks ||--o{ task_members : "assigned"
    tasks ||--o{ task_requirements : "requires"
    tasks ||--o{ attachments : "has_files"
    tasks ||--o{ task_equipment : "uses"
    tasks ||--o{ quality_checks : "checked"
    tasks ||--o{ manufacturing_metrics : "measured"
    tasks ||--o{ comments : "discussed"
    tasks ||--o{ task_history : "tracked"
    tasks ||--o{ task_swimlanes : "organized"

    task_requirements ||--o{ attachments : "fulfills"

    equipment ||--o{ task_equipment : "used_in"

    project_members }|--|| users : "member"
    project_members }|--|| projects : "belongs_to"
    
    task_members }|--|| users : "member"
    task_members }|--|| tasks : "works_on"
    
    task_swimlanes }|--|| tasks : "categorized"
    task_swimlanes }|--|| swimlanes : "belongs_to"